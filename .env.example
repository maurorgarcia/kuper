# URL pública final (dominio pendiente). Se usa en canonical, sitemap, robots y Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.example.com
# Mostrar marcas "A validar" y bloque de pendientes (solo para revisión interna). En producción: false.
NEXT_PUBLIC_SHOW_PENDING=false
# Reseñas de Google vía Apify (solo para `npm run reviews`; ponerlas en .env.local, nunca commitear).
APIFY_TOKEN=
GOOGLE_MAPS_PLACE_URL=
